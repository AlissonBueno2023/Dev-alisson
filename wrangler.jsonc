{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sayure-tv",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "previews": {},
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
